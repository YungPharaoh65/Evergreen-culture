rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 🌿 Garden Forms
    match /gardenForms/{docId} {
      allow read, create, update, delete: if request.auth != null;
    }

    // 👤 Users collection — users can only access their own data
    match /users/{userId} {
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;
    }

    // 👩‍🌾 Gardeners collection
    match /gardeners/{docId} {
      allow read, create, update, delete: if request.auth != null;
    }

    // 🌱 Plants collection
    match /plants/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // 💬 Community Topics
    match /communityTopics/{docId} {
      // Anyone can read topics
      allow read: if true;

      // Only signed-in users can create new topics
      allow create: if request.auth != null;

      // Updates — allow adding comments or editing the topic author wants
      allow update: if request.auth != null &&
        (
          // Author can edit their own topic fields except createdAt
          (request.auth.uid == resource.data.authorId &&
           request.resource.data.title == resource.data.title &&
           request.resource.data.authorId == resource.data.authorId &&
           request.resource.data.createdAt == resource.data.createdAt
          )
          ||
          // Any user can append to comments
          (request.resource.data.keys().hasAll(["comments"]) &&
           request.resource.data.keys().hasOnly(resource.data.keys()) &&
           request.resource.data.comments.size() >= resource.data.comments.size() &&
           request.resource.data.comments[resource.data.comments.size()].email == request.auth.token.email
          )
        );

      // Only the topic author (or admin) can delete their own topic
      allow delete: if request.auth != null &&
        (request.auth.uid == resource.data.authorId || request.auth.token.isAdmin == true);
    }

    // 🔐 Admin Logins Collection
    match /adminLogins/{docId} {
      allow read, create, update, delete: if request.auth != null;
    }

    // 🗣️ Feedbacks collection
    match /feedbacks/{docId} {
      allow read, create, update, delete: if request.auth != null;
    }

    // 💬 Chatbot Feedbacks Collection (NEW)
    match /chatbotFeedbacks/{docId} {
      allow read: if true; // everyone can read messages
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

  }
}
